# ---------------------------------------------------------------------------
# KeyLease environment — copy to .env and fill in after running:
#   ./scripts/deploy-testnet.sh
# .env is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
# One of: testnet | mainnet | futurenet | local
KEYLEASE_NETWORK=testnet

# Soroban RPC endpoint. SDF hosts Testnet; Mainnet is third-party only.
#   testnet   https://soroban-testnet.stellar.org
#   futurenet https://rpc-futurenet.stellar.org
#   mainnet   https://mainnet.sorobanrpc.com
KEYLEASE_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (used to sign transactions).
#   testnet   Test SDF Network ; September 2015
#   mainnet   Public Global Stellar Network ; September 2015
#   futurenet Test SDF Future Network ; October 2022
KEYLEASE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Registry (filled in by scripts/deploy-testnet.sh) ---------------------
# The deployed KeyLeaseRegistry contract id (starts with C).
KEYLEASE_CONTRACT_ID=

# The service_id returned by register_service (a decimal u64).
KEYLEASE_SERVICE_ID=

# SEP-41 / SAC address used to escrow deposits.
KEYLEASE_TOKEN_ADDRESS=

# --- Accounts --------------------------------------------------------------
# Public addresses only. Keep secret seeds in the Stellar CLI keystore or an
# OS secret manager, never in this file.
KEYLEASE_ADMIN=
KEYLEASE_PROVIDER=
KEYLEASE_CONSUMER=

# --- Service defaults ------------------------------------------------------
# Price per metered call, in token stroops (7 decimals).
KEYLEASE_RATE_PER_CALL=1000000

# 32-byte commitment to the off-chain endpoint descriptor (64 hex chars).
KEYLEASE_ENDPOINT_HASH=

# Registry admin (only used by tooling that calls set_token).
KEYLEASE_ADMIN_SECRET=

# --- Gateway (@keylease/cli, @keylease/proxy) ------------------------------
# Secret used to sign kls1.* session tokens (>= 32 bytes, base64url).
KEYLEASE_SESSION_SECRET=

# Listen port for the edge proxy.
KEYLEASE_PROXY_PORT=8787

# Upstream API the proxy forwards verified requests to.
KEYLEASE_UPSTREAM_URL=
