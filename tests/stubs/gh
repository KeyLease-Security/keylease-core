#!/usr/bin/env bash
# Test stub for the GitHub CLI.
#
# Records argv in $STUB_LOG and answers locally: `gh issue list` reports no
# existing issues, and every mutating subcommand is a no-op. Nothing in the
# suite reaches GitHub.
set -euo pipefail

printf 'gh %s\n' "$*" >>"${STUB_LOG:-/dev/null}"

if [ "${1:-}" = "issue" ] && [ "${2:-}" = "list" ]; then
  exit 0
fi

exit 0
